{
  "datasets": [
    {
      "name": "ds_sla",
      "displayName": "Depot SLA (30 days)",
      "queryLines": [
        "SELECT d.name AS depot, d.region, s.sla_date, s.deliveries, s.on_time, s.on_time_pct, ",
        "s.sla_target_pct, CASE WHEN s.sla_met THEN 0 ELSE 1 END AS missed_day ",
        "FROM depot_sla_daily s JOIN depots d ON d.depot_id = s.depot_id ",
        "WHERE s.sla_date >= date_sub(current_date(), 30) AND s.sla_date < current_date()"
      ]
    },
    {
      "name": "ds_sla_week",
      "displayName": "SLA last week by depot",
      "queryLines": [
        "SELECT d.name AS depot, d.region, ROUND(SUM(s.on_time) / SUM(s.deliveries), 4) AS on_time_pct, ",
        "MAX(s.sla_target_pct) AS sla_target_pct, SUM(CASE WHEN s.sla_met THEN 0 ELSE 1 END) AS missed_days, ",
        "SUM(s.deliveries) AS deliveries FROM depot_sla_daily s JOIN depots d ON d.depot_id = s.depot_id ",
        "WHERE s.sla_date >= date_sub(current_date(), 7) AND s.sla_date < current_date() ",
        "GROUP BY d.name, d.region ORDER BY missed_days DESC, on_time_pct"
      ]
    },
    {
      "name": "ds_late",
      "displayName": "Late deliveries by cause (30 days)",
      "queryLines": [
        "SELECT h.delivery_date, h.region, h.cause_code, c.name AS carrier, COUNT(*) AS late_deliveries ",
        "FROM delivery_history h JOIN carriers c ON c.carrier_id = h.carrier_id ",
        "WHERE h.on_time = false AND h.delivery_date >= date_sub(current_date(), 30) ",
        "GROUP BY h.delivery_date, h.region, h.cause_code, c.name"
      ]
    },
    {
      "name": "ds_decisions",
      "displayName": "Decisions synced from the app",
      "queryLines": [
        "SELECT CAST(decided_at AS TIMESTAMP) AS decided_at, DATE(CAST(decided_at AS TIMESTAMP)) AS decision_date, ",
        "decision_type, decision, COALESCE(reason_code, 'n/a') AS reason_code, actor_role, ",
        "feat_region AS region, outcome_known, outcome_on_time, amount_usd FROM decision_labels"
      ]
    },
    {
      "name": "ds_exceptions",
      "displayName": "Exceptions opened",
      "queryLines": [
        "SELECT reason_code AS exception_type, region, DATE(CAST(decided_at AS TIMESTAMP)) AS decision_date ",
        "FROM decision_labels WHERE decision_type = 'exception' AND decision = 'open'"
      ]
    }
  ],
